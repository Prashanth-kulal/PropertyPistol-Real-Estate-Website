{
  "name": "propertypistol-backend",
  "version": "1.0.0",
  "description": "Express + MongoDB backend for the PropertyPistol / AuraLiving real-estate frontend",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "seed:fresh": "node scripts/seed.js --fresh",
    "export:frontend": "node scripts/export-frontend-data.mjs",
    "create-admin": "node scripts/create-admin.js",
    "test": "node --test \"tests/*.test.js\""
  },
  "dependencies": {
    "auraliving": "file:..",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "morgan": "^1.12.1",
    "nodemailer": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2"
  }
}
